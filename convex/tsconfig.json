{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/convex/*": ["./*"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["./**/*.ts"]
}
